# Servidor web do SmartTrafficFlow: serve o build do frontend, repassa /api ao backend
# e cuida do HTTPS automático (Let's Encrypt) quando o domínio é público.
{
	# O container roda sem root e não precisa confiar na CA local dentro de si.
	skip_install_trust

	servers {
		protocols h1 h2
	}
}

# O domínio vem da variável SMARTTRAFFIC_DOMAIN. Sem ela o padrão é localhost,
# para o qual o Caddy gera um certificado local (não confiável pelos navegadores).
{$SMARTTRAFFIC_DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy smarttraffic-backend:8080
	}

	# Arquivos do build têm hash no nome: cache longo, mas só para arquivo que existe.
	# Um asset ausente (por exemplo, de um deploy anterior) responde 404 em vez de cair no index.html.
	handle /assets/* {
		root * /srv

		@existe file
		header @existe Cache-Control "public, max-age=31536000, immutable"

		file_server
	}

	handle {
		root * /srv

		# O index.html muda a cada deploy e aponta para os assets novos.
		header Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
