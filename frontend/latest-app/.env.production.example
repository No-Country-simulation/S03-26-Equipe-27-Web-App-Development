# Variáveis VITE_ são lidas no BUILD (npm run build), não em tempo de execução.
# Para um build local, copie este arquivo para .env.production. O .env.production não é versionado.
#
# No Docker Compose o build do web já define VITE_API_BASE_URL=/api; não é preciso criar este arquivo.
#
# Endereço da API. "/api" é relativo ao endereço em que o frontend é servido: o Caddy repassa
# essas chamadas ao backend. Sem a variável, o padrão do código é http://localhost:8080/api (desenvolvimento).
VITE_API_BASE_URL=/api
