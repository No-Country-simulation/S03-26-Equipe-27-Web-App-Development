# Variáveis do Docker Compose (infra/docker-compose.yml).
# Copie este arquivo para infra/.env e preencha os valores. O .env não é versionado.
#
# As senhas NÃO têm valor padrão: sem elas o "docker compose" se recusa a subir.
# Gere valores fortes e únicos, por exemplo com: openssl rand -base64 24

# Arquivo de variáveis lido pelo container do backend (veja backend/.env.example).
# Os valores abaixo são os do servidor. Para subir localmente, aponte para arquivos seus, por exemplo:
#   SMARTTRAFFIC_BACKEND_ENV_FILE=../backend/.env
SMARTTRAFFIC_BACKEND_ENV_FILE=/opt/smarttrafficflow/env/backend.env

# Diretório do host com o export.geojson de ruas (montado como somente leitura no backend).
# Localmente, aponte para uma pasta que exista (a .tmp/ da raiz é ignorada pelo git), por exemplo:
#   SMARTTRAFFIC_DATA_DIR=../.tmp/dados
SMARTTRAFFIC_DATA_DIR=/opt/smarttrafficflow/data

# Servidor web (Caddy): serve o frontend, repassa /api ao backend e cuida do HTTPS.
# Domínio público que aponta para o servidor. Com um domínio real, o Caddy obtém o certificado
# (Let's Encrypt) sozinho; as portas 80 e 443 precisam estar acessíveis pela internet.
# Sem a variável o padrão é localhost, com certificado local não confiável pelos navegadores.
SMARTTRAFFIC_DOMAIN=localhost
# Endereço e porta do host para o HTTP e o HTTPS do web. Padrão: 80 e 443 em todas as interfaces.
# Para testes locais em outras portas, por exemplo: 8081 e 8443 (ou 127.0.0.1:8443).
SMARTTRAFFIC_WEB_HTTP_BIND=80
SMARTTRAFFIC_WEB_HTTPS_BIND=443
# Origens aceitas pelo CORS do backend. Opcional: o padrão é https://<SMARTTRAFFIC_DOMAIN>.
# Só defina ao usar porta diferente de 443, por exemplo: https://localhost:8443
# SMARTTRAFFIC_CORS_ALLOWED_ORIGINS=

# Banco de dados (PostgreSQL + PostGIS).
SMARTTRAFFIC_DB_USER=postgres
# OBRIGATÓRIA. Deve ser a mesma senha usada em SPRING_DATASOURCE_PASSWORD no backend.env.
SMARTTRAFFIC_DB_PASSWORD=
SMARTTRAFFIC_DB_NAME=smarttrafficflow
# Endereço e porta do host em que o banco é publicado (somente local por padrão).
SMARTTRAFFIC_DB_PORT_BIND=127.0.0.1:5432

# pgAdmin (perfil "admin"). A senha é exigida mesmo sem o perfil, porque o Compose lê o arquivo inteiro.
SMARTTRAFFIC_PGADMIN_EMAIL=admin@admin.com
# OBRIGATÓRIA.
SMARTTRAFFIC_PGADMIN_PASSWORD=
SMARTTRAFFIC_PGADMIN_PORT_BIND=127.0.0.1:8100
